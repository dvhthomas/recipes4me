#!/usr/bin/env bash
# Image compression utility for recipe content.
#
# Usage:
#   ./squish content/recipes/tomato-soup         # Dry run (show what will be compressed)
#   ./squish content/recipes/tomato-soup --now    # Actually compress and resize images
#   ./squish content/recipes/tomato-soup --clean  # Replace originals with compressed versions

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Max width for resized images (pixels)
MAX_WIDTH=1600

error() {
    printf "${RED}Error: %s${NC}\n" "$1" >&2
    exit 1
}

success() {
    printf "${GREEN}✓ %s${NC}\n" "$1"
}

warning() {
    printf "${YELLOW}⚠  %s${NC}\n" "$1"
}

check_dependencies() {
    missing=""

    if ! command -v pngquant >/dev/null 2>&1; then
        missing="${missing}pngquant "
    fi

    if ! command -v oxipng >/dev/null 2>&1; then
        missing="${missing}oxipng "
    fi

    if ! command -v jpegoptim >/dev/null 2>&1; then
        missing="${missing}jpegoptim "
    fi

    if ! command -v sips >/dev/null 2>&1 && ! command -v convert >/dev/null 2>&1; then
        missing="${missing}sips-or-imagemagick "
    fi

    if [ -n "$missing" ]; then
        error "Missing required tools: $missing\n\nInstall with:\n  brew install pngquant oxipng jpegoptim"
    fi
}

show_usage() {
    cat << EOF
Usage: squish DIRECTORY [--now] [--clean]

Compress and resize images in recipe content directories.

Arguments:
  DIRECTORY   Path to a content directory (e.g., content/recipes/tomato-soup)
  --now       Actually compress and resize (default is dry-run mode)
  --clean     Replace originals with compressed versions (destructive)

Images wider than ${MAX_WIDTH}px are resized down before compression.
PNG files are compressed with pngquant + oxipng.
JPEG files are compressed with jpegoptim.

Examples:
  ./squish content/recipes/tomato-soup         # Dry run
  ./squish content/recipes/tomato-soup --now   # Compress and resize
  ./squish content/recipes/tomato-soup --clean # Replace originals
EOF
    exit 0
}

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_usage
fi

DIR_PATH="$1"
DRY_RUN=1
CLEAN_MODE=0

shift
while [ $# -gt 0 ]; do
    case "$1" in
        --now)
            DRY_RUN=0
            ;;
        --clean)
            CLEAN_MODE=1
            ;;
        *)
            error "Unknown argument: $1"
            ;;
    esac
    shift
done

if [ -d "$DIR_PATH" ]; then
    TARGET_DIR="$(cd "$DIR_PATH" && pwd)"
else
    error "Directory not found: $DIR_PATH"
fi

get_file_size() {
    if [ "$(uname)" = "Darwin" ]; then
        stat -f%z "$1"
    else
        stat -c%s "$1"
    fi
}

get_image_width() {
    if command -v sips >/dev/null 2>&1; then
        sips -g pixelWidth "$1" 2>/dev/null | awk '/pixelWidth/{print $2}'
    elif command -v identify >/dev/null 2>&1; then
        identify -format '%w' "$1" 2>/dev/null
    else
        echo "0"
    fi
}

resize_image() {
    local file="$1"
    local max_w="$2"

    if command -v sips >/dev/null 2>&1; then
        sips --resampleWidth "$max_w" "$file" >/dev/null 2>&1
    elif command -v convert >/dev/null 2>&1; then
        convert "$file" -resize "${max_w}x>" "$file"
    fi
}

bytes_to_kb() {
    echo "scale=1; $1 / 1024" | bc
}

calc_percent() {
    echo "scale=1; (1 - $1 / $2) * 100" | bc
}

# Dry run
dry_run_images() {
    cd "$TARGET_DIR"

    echo "============================================================"
    echo "DRY RUN - Images that will be compressed (recursive):"
    echo "============================================================"

    total_size=0
    image_count=0

    while IFS= read -r -d '' original; do
        image_count=$((image_count + 1))
        orig_size=$(get_file_size "$original")
        total_size=$((total_size + orig_size))
        orig_kb=$(bytes_to_kb "$orig_size")
        width=$(get_image_width "$original")
        rel_path=$(echo "$original" | sed 's|^\./||')

        resize_note=""
        if [ "$width" -gt "$MAX_WIDTH" ] 2>/dev/null; then
            resize_note=" (${width}px → ${MAX_WIDTH}px)"
        fi

        printf "%-40s %10sKB%s\n" "$rel_path" "$orig_kb" "$resize_note"
    done < <(find . \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" \) ! -name "*-fs8.png" ! -name "*-squished.*" -type f -print0 2>/dev/null | sort -z)

    if [ $image_count -eq 0 ]; then
        echo "No images found in $TARGET_DIR"
        exit 0
    fi

    echo "============================================================"
    total_kb=$(bytes_to_kb "$total_size")
    printf "TOTAL: %d image(s)%*s%10sKB\n" "$image_count" $((25 - ${#image_count})) "" "$total_kb"
    echo ""
    echo "To actually compress these images, run:"
    echo "  ./squish $DIR_PATH --now"
}

# Compress images
squish_images() {
    cd "$TARGET_DIR"

    png_list=$(mktemp)
    jpg_list=$(mktemp)

    while IFS= read -r -d '' f; do
        echo "$f" >> "$png_list"
    done < <(find . -name "*.png" ! -name "*-fs8.png" -type f -print0 2>/dev/null)

    while IFS= read -r -d '' f; do
        echo "$f" >> "$jpg_list"
    done < <(find . \( -name "*.jpg" -o -name "*.jpeg" \) ! -name "*-squished.*" -type f -print0 2>/dev/null)

    png_count=$(wc -l < "$png_list" | tr -d ' ')
    jpg_count=$(wc -l < "$jpg_list" | tr -d ' ')
    total=$((png_count + jpg_count))

    if [ "$total" -eq 0 ]; then
        echo "No images found in $TARGET_DIR"
        rm -f "$png_list" "$jpg_list"
        exit 0
    fi

    echo "Found $total image(s) to compress ($png_count PNG, $jpg_count JPEG)"

    # Resize oversized images first
    echo ""
    echo "[1/3] Resizing images wider than ${MAX_WIDTH}px..."
    resized=0

    for list in "$png_list" "$jpg_list"; do
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            width=$(get_image_width "$f")
            if [ "$width" -gt "$MAX_WIDTH" ] 2>/dev/null; then
                resize_image "$f" "$MAX_WIDTH"
                rel_path=$(echo "$f" | sed 's|^\./||')
                success "Resized $rel_path (${width}px → ${MAX_WIDTH}px)"
                resized=$((resized + 1))
            fi
        done < "$list"
    done

    if [ $resized -eq 0 ]; then
        echo "  No images needed resizing."
    fi

    # Compress PNGs
    if [ "$png_count" -gt 0 ]; then
        echo ""
        echo "[2/3] Compressing PNGs (pngquant + oxipng)..."

        while IFS= read -r original; do
            [ -z "$original" ] && continue
            pngquant --quality 20-50 --skip-if-larger --force "$original" 2>/dev/null || true
        done < "$png_list"

        while IFS= read -r -d '' fs8; do
            oxipng -o 3 -i 0 --strip safe "$fs8" 2>/dev/null || true
        done < <(find . -name "*-fs8.png" -type f -print0 2>/dev/null)

        success "PNG compression done"
    fi

    # Compress JPEGs
    if [ "$jpg_count" -gt 0 ]; then
        echo ""
        echo "[3/3] Compressing JPEGs (jpegoptim)..."

        while IFS= read -r original; do
            [ -z "$original" ] && continue
            dir=$(dirname "$original")
            base=$(basename "$original")
            ext="${base##*.}"
            name="${base%.*}"
            squished="${dir}/${name}-squished.${ext}"

            cp "$original" "$squished"
            jpegoptim --max=80 --strip-all --quiet "$squished" 2>/dev/null || true
        done < "$jpg_list"

        success "JPEG compression done"
    fi

    # Results
    echo ""
    echo "============================================================"
    echo "Compression Results:"
    echo "============================================================"

    total_original=0
    total_compressed=0

    # PNG results
    while IFS= read -r original; do
        [ -z "$original" ] && continue
        dir=$(dirname "$original")
        name=$(basename "$original" .png)
        compressed="${dir}/${name}-fs8.png"
        rel_path=$(echo "$original" | sed 's|^\./||')

        if [ -f "$compressed" ]; then
            orig_size=$(get_file_size "$original")
            comp_size=$(get_file_size "$compressed")
            total_original=$((total_original + orig_size))
            total_compressed=$((total_compressed + comp_size))
            orig_kb=$(bytes_to_kb "$orig_size")
            comp_kb=$(bytes_to_kb "$comp_size")
            savings=$(calc_percent "$comp_size" "$orig_size")
            printf "%-40s %7sKB → %7sKB (%5s%% reduction)\n" "$rel_path" "$orig_kb" "$comp_kb" "$savings"
        else
            orig_size=$(get_file_size "$original")
            orig_kb=$(bytes_to_kb "$orig_size")
            printf "%-40s %7sKB    (skipped)\n" "$rel_path" "$orig_kb"
        fi
    done < "$png_list"

    # JPEG results
    while IFS= read -r original; do
        [ -z "$original" ] && continue
        dir=$(dirname "$original")
        base=$(basename "$original")
        ext="${base##*.}"
        name="${base%.*}"
        compressed="${dir}/${name}-squished.${ext}"
        rel_path=$(echo "$original" | sed 's|^\./||')

        if [ -f "$compressed" ]; then
            orig_size=$(get_file_size "$original")
            comp_size=$(get_file_size "$compressed")
            total_original=$((total_original + orig_size))
            total_compressed=$((total_compressed + comp_size))
            orig_kb=$(bytes_to_kb "$orig_size")
            comp_kb=$(bytes_to_kb "$comp_size")
            savings=$(calc_percent "$comp_size" "$orig_size")
            printf "%-40s %7sKB → %7sKB (%5s%% reduction)\n" "$rel_path" "$orig_kb" "$comp_kb" "$savings"
        else
            orig_size=$(get_file_size "$original")
            orig_kb=$(bytes_to_kb "$orig_size")
            printf "%-40s %7sKB    (skipped)\n" "$rel_path" "$orig_kb"
        fi
    done < "$jpg_list"

    if [ $total_original -gt 0 ]; then
        total_orig_kb=$(bytes_to_kb "$total_original")
        total_comp_kb=$(bytes_to_kb "$total_compressed")
        total_savings=$(calc_percent "$total_compressed" "$total_original")
        echo "============================================================"
        printf "%-40s %7sKB → %7sKB (%5s%% reduction)\n" "TOTAL" "$total_orig_kb" "$total_comp_kb" "$total_savings"
    fi

    echo ""
    success "Compression complete!"
    echo ""
    echo "Compressed images saved with '-fs8' (PNG) or '-squished' (JPEG) suffix."
    echo "Review the results, then run with --clean to replace originals:"
    echo "  ./squish $DIR_PATH --clean"

    rm -f "$png_list" "$jpg_list"
}

# Clean: replace originals with compressed versions
clean_images() {
    cd "$TARGET_DIR"

    found=0

    while IFS= read -r -d '' compressed; do
        found=$((found + 1))
    done < <(find . \( -name "*-fs8.png" -o -name "*-squished.jpg" -o -name "*-squished.jpeg" \) -type f -print0 2>/dev/null)

    if [ $found -eq 0 ]; then
        error "No compressed images found. Run with --now first."
    fi

    echo "Found $found compressed image(s) to promote"
    echo ""
    warning "WARNING: This will permanently replace the original images!"
    echo ""
    printf "Proceed? (yes/no): "
    read -r response

    if [ "$response" != "yes" ] && [ "$response" != "y" ]; then
        echo "Aborted."
        exit 0
    fi

    echo ""

    # Clean PNGs (-fs8.png → .png)
    while IFS= read -r -d '' compressed; do
        dir=$(dirname "$compressed")
        name=$(basename "$compressed" .png)
        original_name=$(echo "$name" | sed 's/-fs8$//')
        original="${dir}/${original_name}.png"

        if [ -f "$original" ]; then
            rm "$original"
            mv "$compressed" "$original"
            rel_path=$(echo "$original" | sed 's|^\./||')
            success "Replaced $rel_path"
        else
            rel_path=$(echo "$compressed" | sed 's|^\./||')
            warning "Original not found for $rel_path, skipping"
        fi
    done < <(find . -name "*-fs8.png" -type f -print0 2>/dev/null)

    # Clean JPEGs (-squished.jpg → .jpg)
    while IFS= read -r -d '' compressed; do
        dir=$(dirname "$compressed")
        base=$(basename "$compressed")
        ext="${base##*.}"
        name="${base%.*}"
        original_name=$(echo "$name" | sed 's/-squished$//')
        original="${dir}/${original_name}.${ext}"

        if [ -f "$original" ]; then
            rm "$original"
            mv "$compressed" "$original"
            rel_path=$(echo "$original" | sed 's|^\./||')
            success "Replaced $rel_path"
        else
            rel_path=$(echo "$compressed" | sed 's|^\./||')
            warning "Original not found for $rel_path, skipping"
        fi
    done < <(find . \( -name "*-squished.jpg" -o -name "*-squished.jpeg" \) -type f -print0 2>/dev/null)

    echo ""
    success "Cleanup complete! Originals replaced with compressed versions."
}

# Main
check_dependencies

echo "Working directory: $TARGET_DIR"
echo ""

if [ $CLEAN_MODE -eq 1 ]; then
    clean_images
elif [ $DRY_RUN -eq 1 ]; then
    dry_run_images
else
    squish_images
fi
